DATABASE_URL=postgres://forge:REPLACE@forge-tenant-postgres:5432/forge?sslmode=disable
POSTGRES_PASSWORD=REPLACE
PUBLIC_URL=http://127.0.0.1:8483
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=forge-tenant-split-console
OIDC_CLIENT_SECRET=REPLACE
CASDOOR_URL=http://casdoor.identity.svc.cluster.local:8000
CASDOOR_CLIENT_ID=REPLACE
CASDOOR_SECRET=REPLACE
CASDOOR_ORGANIZATION=enterprise-identities
GITLAB_URL=https://gitlab.example.com
GITLAB_PUBLIC_URL=https://gitlab.example.com
GITLAB_OIDC_CLIENT_ID=gitlab
GITLAB_TOKEN=REPLACE
# Helm sets the projected Secret path. Leave empty for env-only local runs.
GITLAB_TOKEN_FILE=
# Read only by the bootstrap maintenance command, never by the API or worker.
BOOTSTRAP_USERNAME=forge-admin
# Encrypts stored idempotency responses. Keep the existing value when renaming
# from APP_KEY, or previously stored responses can no longer be decrypted.
TENANT_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CA_FILE=/ca/ca.crt
GIN_MODE=release
